{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iberolab-es/IberoLab/blob/main/data/schema/pronunciation-profile.schema.json",
  "title": "IberoLab Spanish pronunciation profile",
  "description": "Contract for a declared European Spanish pronunciation profile. The schema does not by itself approve a profile or enable public conversion.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "status",
    "language_tag",
    "geographic_scope",
    "register_scope",
    "label",
    "declared_dimensions",
    "lexical_exception_policy",
    "unknown_word_policy",
    "source_set",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^es-es-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "preview", "under_review", "approved", "deprecated"]},
    "language_tag": {"const": "es-ES"},
    "geographic_scope": {
      "type": "object",
      "required": ["description", "included_areas", "excluded_claims"],
      "properties": {
        "description": {"type": "string", "minLength": 20},
        "included_areas": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        },
        "excluded_claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10}
        }
      },
      "additionalProperties": false
    },
    "register_scope": {
      "type": "object",
      "required": ["style", "speech_rate", "connected_speech_depth"],
      "properties": {
        "style": {"enum": ["careful", "formal", "general", "colloquial", "multiple"]},
        "speech_rate": {"enum": ["slow", "moderate", "natural_variable", "multiple"]},
        "connected_speech_depth": {"enum": ["lexical_only", "word_boundary_rules", "phrase_level"]}
      },
      "additionalProperties": false
    },
    "label": {"type": "string", "minLength": 5},
    "declared_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["dimension_id", "option_id", "selection_status", "notes"],
        "properties": {
          "dimension_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "option_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "selection_status": {"enum": ["explicit", "lexical", "contextual", "ambiguity_branch"]},
          "notes": {"type": "string", "minLength": 10}
        },
        "additionalProperties": false
      }
    },
    "lexical_exception_policy": {
      "enum": [
        "reviewed_lexicon_then_block",
        "reviewed_lexicon_then_user_pronunciation",
        "reviewed_lexicon_then_ambiguity_branch"
      ]
    },
    "unknown_word_policy": {
      "enum": ["block", "require_user_pronunciation", "ambiguity_branch_without_ranking"]
    },
    "source_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["citation", "url", "scope", "source_type"],
        "properties": {
          "citation": {"type": "string", "minLength": 10},
          "url": {"type": "string", "pattern": "^https://"},
          "scope": {"type": "string", "minLength": 10},
          "source_type": {"enum": ["academy_reference", "peer_reviewed_phonetic_description", "reviewed_lexicon", "project_decision"]}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["internal_review", "external_review", "approval_date", "review_notes"],
      "properties": {
        "internal_review": {"enum": ["pending", "passed", "failed"]},
        "external_review": {"enum": ["pending", "passed", "failed", "not_required_for_preview"]},
        "approval_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "review_notes": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "approved"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "internal_review": {"const": "passed"},
              "external_review": {"const": "passed"},
              "approval_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            },
            "required": ["internal_review", "external_review", "approval_date"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
